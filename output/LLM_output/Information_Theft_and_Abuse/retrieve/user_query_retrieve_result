    private static void CopyLib(Context ctx) {
        JarFile jarFile;
        String apkFilePath = ctx.getApplicationInfo().sourceDir;
        try {
            jarFile = new JarFile(apkFilePath);
        } catch (IOException e) {
            e = e;
        }
        try {
            Enumeration<JarEntry> iter = jarFile.entries();
            while (iter.hasMoreElements()) {
                JarEntry jarEntry = iter.nextElement();
                String jarEntryName = jarEntry.getName();
                if (jarEntryName.equals("assets/libsecexe.x86.so")) {
                    String soName = jarEntryName.replaceAll("assets/", "");
                    String destSoName = "/data/data/" + ctx.getPackageName() + "/.cache/" + soName;
                    realCopy(destSoName, jarFile, jarEntry);
                }
                if (jarEntryName.equals("assets/libsecmain.x86.so")) {
                    jarEntryName.replaceAll("assets/", "");
                    String destSoName2 = "/data/data/" + ctx.getPackageName() + "/.cache/libsecmain.x86.so";
                    realCopy(destSoName2, jarFile, jarEntry);
                }
                if (jarEntryName.equals("assets/" + ctx.getPackageName() + ".x86")) {
                    jarEntryName.replaceAll("assets/", "");
                    String destSoName3 = "/data/data/" + ctx.getPackageName() + "/.cache/" + ctx.getPackageName();
                    realCopy(destSoName3, jarFile, jarEntry);
                }
            }
        } catch (IOException e2) {
            e = e2;
            e.printStackTrace();
        }
    }

