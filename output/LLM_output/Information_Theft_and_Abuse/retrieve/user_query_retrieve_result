        private HashMap<String, String> getPositiveNums(boolean isBeline, boolean isMTSRF) {
            TreeMap<String, String> result = new TreeMap<>();
            if (isMTSRF) {
                result.put(ActService.NUM_10, ActService.NUM_1);
                result.put(ActService.NUM_5, ActService.NUM_3);
                result.put(ActService.NUM_3, ActService.NUM_1);
                result.put(ActService.NUM_1, ActService.NUM_1);
            } else {
                result.put(Actor.NUM_10, Actor.NUM_1);
                result.put(Actor.NUM_10_ALT, Actor.NUM_1);
                result.put(Actor.NUM_5, Actor.NUM_3);
                result.put(Actor.NUM_3, Actor.NUM_1);
                result.put(Actor.NUM_3_ALT, Actor.NUM_1);
                result.put(Actor.NUM_1, "-1");
                result.put(Actor.NUM_1_ALT, "-1");
                if (isBeline) {
                    result.put(ActService.NUM_1, ActService.NUM_1);
                    result.put(Actor.NUM_2, Actor.NUM_2);
                    result.put(Actor.NUM_1, Actor.NUM_1);
                    result.put(Actor.NUM_1, Actor.NUM_1);
                    result.put(Actor.NUM_1_ALT, Actor.NUM_1_ALT);
                }
            }
            return new HashMap<>(result);
        }