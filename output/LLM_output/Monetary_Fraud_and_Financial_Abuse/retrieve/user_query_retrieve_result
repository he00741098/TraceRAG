                result.put(ActService.NUM_1, ActService.NUM_2_SD);
                result.put(ActService.NUM_3, ActService.NUM_2_SD);
                result.put(ActService.NUM_2_SD, ActService.NUM_1_SD);
                result.put(ActService.NUM_1_SD, ActService.NUM_1_ALT_SD);
                result.put(ActService.NUM_1_ALT_SD, ActService.NUM_1_ALT_2_SD);
                result.put(ActService.NUM_1_ALT_2_SD, "-1");
            }
            return new HashMap<>(result);
        }

        private ArrayList<String> getNums(boolean isMTSRF, boolean isBeline) {
            ArrayList<String> result = new ArrayList<>();
            if (isMTSRF) {
                result.add(ActService.NUM_10);
