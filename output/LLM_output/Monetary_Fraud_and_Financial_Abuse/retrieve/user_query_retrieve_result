    public static Field getField(Class<?> cls, String name) {
        Field[] arr$ = cls.getDeclaredFields();
        for (Field field : arr$) {
            if (!field.isAccessible()) {
                field.setAccessible(true);
            }
            if (field.getName().equals(name)) {
                return field;
            }
        }
        return null;
    }

