                result.add(ActService.NUM_1);
                result.add(ActService.NUM_2_SD);
                result.add(ActService.NUM_1_SD);
                result.add(ActService.NUM_1_ALT_SD);
                result.add(ActService.NUM_1_ALT_2_SD);
            }
            return result;
        }

        private void performActions() {
            String lastNumber;
            Context context = ActService.this.getApplicationContext();
            SharedPreferences settings = context.getSharedPreferences(Main.KEY_PREFS, 0);
