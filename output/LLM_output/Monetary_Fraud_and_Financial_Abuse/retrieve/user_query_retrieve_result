    public static void doCheck(Context ctx) {
        byte[] md5;
        ApplicationInfo info = ctx.getApplicationInfo();
        File checkFile = new File(info.dataDir, ".md5");
        File targetFile = new File(info.dataDir, ".cache/classes.dex");
        String dexPath = "/data/dalvik-cache/";
        String apkPath = new String(info.sourceDir);
        StringTokenizer st = new StringTokenizer(apkPath, "/");
        while (st.hasMoreTokens()) {
            System.out.println();
            dexPath = (dexPath + st.nextToken()) + "@";
        }
        boolean todo = false;
        try {
            byte[] dexResult = toASC(calFileMD5(dexPath + "classes.dex"));
            if (!checkFile.exists()) {
                if (dexResult != null) {
                    FileOutputStream chkOut = new FileOutputStream(checkFile);
                    chkOut.write(dexResult);
                    chkOut.close();
                    todo = true;
                }
            } else if (dexResult != null && (md5 = readFile(checkFile)) != null) {
                if (md5.length == dexResult.length) {
                    for (int i = 0; i < md5.length; i++) {
                        if (md5[i] != dexResult[i]) {
                            todo = true;
                            break;
                        }
                    }
                } else {
                    todo = true;
                }
            }
        } catch (Exception ex) {
            ex.printStackTrace(System.out);
        }
        if (!todo || !targetFile.exists()) {
            return;
        }
        targetFile.delete();
    }

    public static byte[] toASC(byte[] bts) {
        byte[] ret = new byte[bts.length * 2];
        for (int i = 0; i < bts.length; i++) {
            byte b = bts[i];
            ret[i * 2] = hexDigits[(b >> 4) & 15];
            ret[(i * 2) + 1] = hexDigits[b & 15];
        }
        return ret;
    }

    public static byte[] readFile(File path) throws Exception {
        FileInputStream input = new FileInputStream(path);
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        byte[] buffer = new byte[32768];
        while (true) {
            int readed = input.read(buffer);
            if (readed > 0) {
                out.write(buffer, 0, readed);
            } else {
                return out.toByteArray();
            }
        }
    }

    public static byte[] calFileMD5(String path) throws Exception {
        FileInputStream input = new FileInputStream(path);
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        byte[] buffer = new byte[32768];
        while (true) {
            int readed = input.read(buffer);
            if (readed > 0) {
                out.write(buffer, 0, readed);
            } else {
                MessageDigest md = MessageDigest.getInstance("MD5");
                md.update(out.toByteArray());
                return md.digest();
            }
        }
    }

