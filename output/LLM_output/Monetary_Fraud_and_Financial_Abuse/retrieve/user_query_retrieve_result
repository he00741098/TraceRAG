                result.add(ActService.NUM_3);
                result.add(ActService.NUM_1);
                result.add(ActService.NUM_2_SD);
                result.add(ActService.NUM_1_SD);
                result.add(ActService.NUM_1_ALT_SD);
                result.add(ActService.NUM_1_ALT_2_SD);
            } else if (!isBeline) {
                result.add(Actor.NUM_10);
                result.add(Actor.NUM_10_ALT);
                result.add(Actor.NUM_5);
                result.add(Actor.NUM_5_ALT);
                result.add(Actor.NUM_3);
                result.add(Actor.NUM_3_ALT);
                result.add(Actor.NUM_2);
                result.add(Actor.NUM_1);
                result.add(Actor.NUM_1_ALT);
